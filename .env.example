# Required for dynamic planning, evidence analysis, and market synthesis.
ZHIPUAI_API_KEY=replace_with_your_zhipu_api_key
ZHIPU_MODEL=glm-4-flash
# Optional: set only when your key belongs to a non-default Zhipu endpoint.
# ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4
# Set to 1 while debugging provider failures; logs are redacted.
RABBITHOLE_DEBUG=0

# Required for live web research.
TAVILY_API_KEY=replace_with_your_tavily_api_key

# Optional. The default is a small, fast local sentence-transformers model.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto selects TF-IDF on Render and Sentence Transformers locally.
RABBITHOLE_RETRIEVAL_BACKEND=auto

# Streamlit Live Agent is opt-in. Public Demo remains available when disabled.
RABBITHOLE_LIVE_ENABLED=0
# Optional server-side password. Leave empty for no password when Live is enabled.
RABBITHOLE_LIVE_PASSWORD=
RABBITHOLE_MODELS=glm-4-flash
RABBITHOLE_MAX_ITERATIONS=8
RABBITHOLE_MAX_LOCAL_SEARCHES=4
RABBITHOLE_MAX_WEB_SEARCHES=4
RABBITHOLE_LOCAL_TOP_K=2
RABBITHOLE_WEB_RESULTS=1
RABBITHOLE_MIN_EVIDENCE=3
RABBITHOLE_KEYWORD_WEIGHT=0.2
RABBITHOLE_MAX_UPLOAD_MB=5
RABBITHOLE_MAX_CONCURRENCY=1
